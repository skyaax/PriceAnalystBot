BOT_TOKEN=
DB_PATH=bot.db
CHECK_INTERVAL_SECONDS=3600

# Telegram Stars are the simplest fit for digital bot features.
# Keep PAYMENT_PROVIDER_TOKEN empty/undefined for Stars if your library supports it.
PAYMENT_CURRENCY=XTR
PREMIUM_PRICE_STARS=199
BUSINESS_PRICE_STARS=499
REFERRAL_REWARD_SLOTS=1
REFERRAL_MAX_BONUS_SLOTS=10

# Format: CODE:plan:days,CODE2:plan:days
# Example partner link: https://t.me/your_bot_username?start=promo_STUDENT7
PROMO_CODES=LAUNCH7:premium:7,STUDENT7:premium:7,PARTNER7:premium:7

# Comma-separated Telegram chat IDs allowed to use /grant.
ADMIN_IDS=123456789
